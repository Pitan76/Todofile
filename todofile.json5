{
  "@config": {
    // コマンド実行エラーを無視して次のコマンドを実行する
    "ignoreCommandExecuteException": false
  },
  // 以下のように"タスク名": "コマンド" もしくは "タスク名": {"コマンド", ...} のように記述する
  "hello": [
    "echo hello"
  ],
  "hoge": [
    "todofile hello",
    "echo hoge"
  ],
  "test": [
    "vendor/bin/phpunit --testdox"
  ],
  "lint": "vendor/bin/phpstan analyse src",
  "composer": [
    "composer install"
  ],
  "composer-reload": "composer dump-autoload"
}
