{
    "name": "pitan76/todofile",
    "type": "library",
    "description": "A simple task runner for developers",
    "keywords": ["task-runner","task", "todofile", "cli", "tool"],
    "homepage": "https://github.com/Pitan76/Todofile",
    "license": "MIT",
    "authors": [
        {
            "name": "PitaQ",
            "email": "admin@pitan76.net",
            "homepage": "https://pitan76.net",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "symfony/console": "^6.4",
        "colinodell/json5": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Pitan76\\Todofile\\": "src/main/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pitan76\\Todofile\\Test\\": "src/test/"
        }
    },
    "bin": [
        "bin/todo"
    ]
}
