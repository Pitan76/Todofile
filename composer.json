{
    "name": "pitan76/todofile",
    "description": "Task runner for developers",
    "type": "library",
    "license": "MIT",
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.2"
    },
    "require": {
        "symfony/console": "^6.4",
        "colinodell/json5": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Pitan76\\Todofile\\": "src/main/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pitan76\\Todofile\\Test\\": "src/test/"
        }
    },
    "bin": [
        "bin/todo"
    ]
}
